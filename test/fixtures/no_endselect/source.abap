CLASS zcl_test_no_endselect DEFINITION
  PUBLIC FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    METHODS test_001.
    METHODS test_002.
    METHODS test_003.
ENDCLASS.

CLASS zcl_test_no_endselect IMPLEMENTATION.
  METHOD test_001.
    SELECT arbgb FROM t100 INTO @DATA(ls_row).
    ENDSELECT.
  ENDMETHOD.

  METHOD test_002.
    DATA lt_tab TYPE STANDARD TABLE OF t100 WITH DEFAULT KEY.
    SELECT arbgb FROM t100 INTO TABLE @lt_tab.
  ENDMETHOD.

  METHOD test_003.
    DATA lt_tab TYPE STANDARD TABLE OF t100 WITH DEFAULT KEY.
    SELECT arbgb FROM t100 INTO TABLE @lt_tab PACKAGE SIZE 100.
    ENDSELECT.
  ENDMETHOD.
ENDCLASS.
