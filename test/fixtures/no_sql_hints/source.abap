CLASS zcl_skylint_test_sql_hints DEFINITION
  PUBLIC FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    METHODS test_001.
    METHODS test_002.
    METHODS test_003.
ENDCLASS.

CLASS zcl_skylint_test_sql_hints IMPLEMENTATION.
  METHOD test_001.
    DATA lt_data TYPE TABLE OF t000.
    SELECT * FROM t000 INTO TABLE lt_data %_HINTS HDB 'INDEX_SEARCH'.
  ENDMETHOD.

  METHOD test_002.
    DATA lt_data TYPE TABLE OF t000.
    SELECT * FROM t000 INTO TABLE lt_data.
  ENDMETHOD.

  METHOD test_003.
    DATA lt_data TYPE TABLE OF t000.
    SELECT * FROM t000 INTO TABLE lt_data %_HINTS HDB 'INDEX_SEARCH'. "#EC NO_SQL_HINTS
  ENDMETHOD.
ENDCLASS.
