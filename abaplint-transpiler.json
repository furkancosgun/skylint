{
  "input_folder": "src/",
  "output_folder": "output/",
  "libs": [
    {
      "folder": "/deps/open-abap-core"
    }
  ],
  "exclude_filter": [
    "zcl_skylint_sci*",
    "zcl_skylint_atc*"
  ],
  "write_unit_tests": true,
  "write_source_map": true,
  "options": {
    "ignoreSyntaxCheck": false,
    "addFilenames": true,
    "addCommonJS": true,
    "unknownTypes": "compileError",
    "setup": {
      "filename": "../scripts/setup.mjs",
      "preFunction": "setup"
    }
  }
}