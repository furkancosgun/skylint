{
  "input_folder": "src/",
  "output_folder": "output/",
  "libs": [
    {
      "folder": "/deps/open-abap-core"
    },
    {
      "folder": "/test/stubs"
    }
  ],
  "exclude_filter": [
    "\\.chk[ovc]\\.json$"
  ],
  "write_unit_tests": true,
  "write_source_map": true,
  "options": {
    "ignoreSyntaxCheck": false,
    "addFilenames": true,
    "addCommonJS": true,
    "unknownTypes": "compileError",
    "skip": []
  }
}
