{
  "input_folder": "src/",
  "output_folder": "output/",
  "libs": [
    {
      "folder": "/deps/open-abap-core"
    }
  ],
  "exclude_filter": [
    "zcl_skylint_sci*",
    "zcl_skylint_atc*",
    "zcl_skylint_test_\\d+"
  ],
  "write_unit_tests": true,
  "write_source_map": true,
  "options": {
    "ignoreSyntaxCheck": false,
    "addFilenames": true,
    "addCommonJS": true,
    "unknownTypes": "compileError",
    "setup": {
      "filename": "../scripts/setup.mjs",
      "preFunction": "setup"
    },
    "skip": [
      {
        "object": "ZCL_SKYLINT_CHECK_026",
        "class": "ltcl_check_026",
        "method": "test_check",
        "note": "requires compiler reference resolution for instance method calls"
      }
    ]
  }
}