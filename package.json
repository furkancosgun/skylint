{
  "name": "skylint",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && abap_transpile abaplint-transpiler.json",
    "test": "npm run lint && npm run unit",
    "unit": "npm run build && node --expose-gc output/index.mjs",
    "lint": "abaplint",
    "fix": "abaplint --fix",
    "clean": "node scripts/clean.mjs",
    "index": "node scripts/indexer.mjs",
    "positions": "node scripts/fill-positions.mjs",
    "deps": "git submodule update --init --recursive",
    "check:cloud": "abaplint .abaplint/abap_cloud.json",
    "check:standard": "abaplint .abaplint/abap_standard.json",
    "sync": "node scripts/sync-branches.mjs all --push",
    "sync:cloud": "node scripts/sync-branches.mjs cloud --push",
    "sync:standard": "node scripts/sync-branches.mjs standard --push"
  },
  "devDependencies": {
    "@abaplint/cli": "latest",
    "@abaplint/database-sqlite": "latest",
    "@abaplint/runtime": "latest",
    "@abaplint/transpiler-cli": "latest",
    "abap-kit": "latest"
  },
  "dependencies": {
    "@abaplint/transpiler": "^2.13.100"
  }
}
