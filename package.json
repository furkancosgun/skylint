{
  "name": "skylint",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.mjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/generate-atc.mjs && npm run clean && abap_transpile abaplint-transpiler.json",
    "test": "npm run lint && npm run unit",
    "unit": "npm run build && node --expose-gc test/run.mjs",
    "lint": "abaplint",
    "fix": "abaplint --fix",
    "clean": "node --eval \"fs.rmSync('output', { recursive: true, force: true })\"",
    "index": "node scripts/indexer.mjs && node scripts/generate-atc.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "node scripts/generate-docs.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deps": "node scripts/fetch-deps.mjs"
  },
  "devDependencies": {
    "@abaplint/cli": "^2.120.80",
    "@abaplint/core": "^2.120.84",
    "@abaplint/runtime": "^2.14.7",
    "@abaplint/transpiler": "^2.14.7",
    "@abaplint/transpiler-cli": "^2.14.7",
    "vitepress": "^1.6.4"
  }
}
