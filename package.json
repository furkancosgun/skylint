{
  "name": "skylint",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "npm run lint",
    "lint": "abaplint",
    "fix": "abaplint --fix",
    "clean": "node scripts/clean.mjs",
    "index": "node scripts/indexer.mjs",
    "deps": "git submodule update --init --recursive",
    "check:cloud": "abaplint .abaplint/abap_cloud.json"
  },
  "devDependencies": {
    "@abaplint/cli": "latest"
  }
}