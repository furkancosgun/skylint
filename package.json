{
  "name": "skylint",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "skylint": "./bin/skylint.mjs"
  },
  "scripts": {
    "build": "node scripts/generate-atc.mjs && npm run clean && abap_transpile abaplint-transpiler.json",
    "test": "npm run lint && npm run unit",
    "unit": "npm run build && node --expose-gc test/run.mjs",
    "lint": "abaplint",
    "fix": "abaplint --fix",
    "clean": "node --eval \"fs.rmSync('output', { recursive: true, force: true })\"",
    "index": "node scripts/indexer.mjs && node scripts/generate-atc.mjs",
    "scan": "node bin/skylint.mjs scan",
    "docs:dev": "vitepress dev docs",
    "docs:build": "node scripts/generate-docs.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deps": "git submodule update --init --recursive"
  },
  "devDependencies": {
    "@abaplint/cli": "latest",
    "@abaplint/runtime": "latest",
    "@abaplint/transpiler": "latest",
    "@abaplint/transpiler-cli": "latest",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
